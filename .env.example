VITE_TEACHER_PASSWORD=teacher123

# NCM diagnostic pilot. Off unless NCM_DIAGNOSTIC_API_ENABLED is true. An admin
# then assigns to any pupil in a class they administer. Listing studentIds below
# narrows it to those accounts; left empty the whole class roster is selectable.
# Note that permanent deletion does not yet clear raw diagnostic keys.
NCM_DIAGNOSTIC_API_ENABLED=false
NCM_DIAGNOSTIC_TEST_STUDENT_IDS=
